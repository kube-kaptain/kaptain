#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Kaptain contributors (Fred Cooke)
#
# Upgrades Kaptain Deploy Scripts and build tooling versions across all deploy images.
# Creates PRs for main (1.35), main-1.32, main-1.33, and main-1.34 branches.
#
# Usage: upgrade-deploy-scripts-version [deploy-scripts-version]
#   If deploy-scripts-version not supplied, uses latest tag from remote.
#   Build tooling version is always resolved from remote.
#
# Idempotent: safe to re-run after partial failure.
# Continues on errors and reports failures at end.
set -uo pipefail

IMAGE_BASE_DIR="${HOME}/projects/kaptain/image"
DEPLOY_IMAGE_DIRS=(
  "image-environment-deploy-alpine-3-23"
  "image-environment-deploy-trixie-slim"
  "image-environment-deploy-ubi-9-minimal"
  "image-environment-deploy-ubuntu-24-04-lts"
)
KUBECTL_VERSIONS=("1.32" "1.33" "1.34" "1.35")
# The version carried on main rather than a main-1.3X branch - must be one of
# the versions above. Bumping to a new kubectl minor means adding it to the
# array and moving this, in that order.
MAIN_KUBECTL_VERSION="1.35"
DOCKERFILE_PATH="src/docker/Dockerfile"
BUILD_WORKFLOW_PATH=".github/workflows/build.yaml"
KAPTAINPM_PATH="KaptainPM.yaml"
GITHUB_ORG="kube-kaptain"
GITHUB_REMOTE_BASE="https://github.com/${GITHUB_ORG}"
BUILDON_COMMIT_MESSAGE_PREFIX="Upgrade to latest build tooling"

NEW_VERSION="${1:-}"

# Track results for summary
declare -a CREATED_PRS=()
declare -a FAILURES=()

log() {
  echo "==> $*"
}

warn() {
  echo "WARNING: $*" >&2
}

record_failure() {
  local context="$1"
  local message="$2"
  FAILURES+=("${context}: ${message}")
  warn "${context}: ${message}"
}

get_latest_remote_tag() {
  local repo="$1"
  git ls-remote --tags --refs "${GITHUB_REMOTE_BASE}/${repo}.git" \
    | sed 's|.*/||' \
    | sort -V \
    | tail -1
}

get_current_version() {
  local dockerfile="$1"
  # Extract version from: FROM .../kaptain-deploy-scripts:X.Y.Z
  grep -E 'kaptain-deploy-scripts:[0-9]+\.[0-9]+\.[0-9]+' "$dockerfile" \
    | sed -E 's/.*kaptain-deploy-scripts:([0-9]+\.[0-9]+\.[0-9]+).*/\1/' \
    | head -1
}

# Find the newest tag containing the kubectl version (e.g., "1.32" matches
# "1.0.1.1.32.1"). Version sorted: the first tag git lists is the oldest.
find_tag_for_kubectl_version() {
  local kube_version="$1"
  git tag --list "*${kube_version}*" | sort -V | tail -1
}

update_dockerfile_version() {
  local dockerfile="$1"
  local old_version="$2"
  local new_version="$3"
  sed -i.bak "s/kaptain-deploy-scripts:${old_version}/kaptain-deploy-scripts:${new_version}/g" "$dockerfile"
  rm -f "${dockerfile}.bak"
}

# Bump the deploy scripts version in the Dockerfile. An empty current version
# means the FROM line no longer matches the expected shape: bail rather than sed
# a bare tag prefix and commit a corrupt image reference.
upgrade_deploy_scripts_version() {
  local context="$1"
  local target_version="$2"
  local commit_message="$3"
  local branch_version
  branch_version=$(get_current_version "$DOCKERFILE_PATH")
  if [[ -z "$branch_version" ]]; then
    record_failure "$context" "No kaptain-deploy-scripts version found in $DOCKERFILE_PATH"
    return 1
  fi
  if [[ "$branch_version" == "$target_version" ]]; then
    log "Version already at $target_version on $context"
    return 0
  fi
  log "Upgrading $branch_version -> $target_version on $context"
  update_dockerfile_version "$DOCKERFILE_PATH" "$branch_version" "$target_version"
  git add "$DOCKERFILE_PATH"
  git commit -m "$commit_message"
}

# buildon tags do not encode the KaptainPM schema version they ship - 1.1.37
# carries 1.19, 1.1.52 carries 1.25 - so read it from the tag itself.
get_schema_version_for_buildon_tag() {
  local tag="$1"
  gh api "repos/${GITHUB_ORG}/buildon-github-actions/contents/src/schemas/version?ref=${tag}" \
    -H "Accept: application/vnd.github.raw" 2>/dev/null | tr -d '[:space:]'
}

get_current_api_version() {
  local project_file="$1"
  if [[ ! -f "$project_file" ]]; then
    return
  fi
  grep -E '^apiVersion: kaptain\.org/[0-9]+(\.[0-9]+)*' "$project_file" \
    | sed -E 's|^apiVersion: kaptain\.org/([0-9]+(\.[0-9]+)*).*|\1|' \
    | head -1
}

update_api_version() {
  local project_file="$1"
  local old_version="$2"
  local new_version="$3"
  sed -i.bak "s|^apiVersion: kaptain\.org/${old_version}$|apiVersion: kaptain.org/${new_version}|" "$project_file"
  rm -f "${project_file}.bak"
}

get_current_buildon_version() {
  local workflow_file="$1"
  if [[ ! -f "$workflow_file" ]]; then
    return
  fi
  grep -E 'buildon-github-actions/.*@[0-9]' "$workflow_file" \
    | sed -E 's/.*@([0-9]+\.[0-9]+\.[0-9]+).*/\1/' \
    | head -1
}

update_build_workflow_version() {
  local workflow_file="$1"
  local old_version="$2"
  local new_version="$3"
  sed -i.bak "s|buildon-github-actions/\([^@]*\)@${old_version}|buildon-github-actions/\1@${new_version}|g" "$workflow_file"
  rm -f "${workflow_file}.bak"
}

# Pins the build tooling and, in the same commit, the schema version that
# tooling ships, declared as the project file's apiVersion.
upgrade_build_tooling() {
  local current_buildon_version
  local current_api_version
  local summary
  # One entry per thing actually bumped, so the message names only those
  local -a changes=()

  current_buildon_version=$(get_current_buildon_version "$BUILD_WORKFLOW_PATH")
  if [[ -z "$current_buildon_version" ]]; then
    log "No buildon-github-actions reference found in $BUILD_WORKFLOW_PATH"
  elif [[ "$current_buildon_version" == "$LATEST_BUILDON_VERSION" ]]; then
    log "Build tooling already at $LATEST_BUILDON_VERSION"
  else
    log "Upgrading build tooling $current_buildon_version -> $LATEST_BUILDON_VERSION"
    update_build_workflow_version "$BUILD_WORKFLOW_PATH" "$current_buildon_version" "$LATEST_BUILDON_VERSION"
    git add "$BUILD_WORKFLOW_PATH"
    changes+=("workflow to ${LATEST_BUILDON_VERSION}")
  fi

  if [[ -n "$LATEST_SCHEMA_VERSION" ]]; then
    current_api_version=$(get_current_api_version "$KAPTAINPM_PATH")
    if [[ -z "$current_api_version" ]]; then
      warn "No apiVersion found in $KAPTAINPM_PATH"
    elif [[ "$current_api_version" == "$LATEST_SCHEMA_VERSION" ]]; then
      log "apiVersion already at kaptain.org/$LATEST_SCHEMA_VERSION"
    else
      log "Upgrading apiVersion kaptain.org/$current_api_version -> kaptain.org/$LATEST_SCHEMA_VERSION"
      update_api_version "$KAPTAINPM_PATH" "$current_api_version" "$LATEST_SCHEMA_VERSION"
      git add "$KAPTAINPM_PATH"
      changes+=("apiVersion to ${LATEST_SCHEMA_VERSION}")
    fi
  fi

  if [[ ${#changes[@]} -eq 0 ]]; then
    return 0
  fi

  if [[ ${#changes[@]} -eq 2 ]]; then
    summary="${changes[0]} and ${changes[1]}"
  else
    summary="${changes[0]}"
  fi
  git commit -m "${BUILDON_COMMIT_MESSAGE_PREFIX}: ${summary}"
}

# Find the latest base image tag matching the kubectl version (e.g., "1.32" matches "1.32.8")
get_latest_base_image_tag() {
  local slug="$1"
  local kube_version="$2"
  git ls-remote --tags --refs "${GITHUB_REMOTE_BASE}/image-environment-base-${slug}.git" \
    | sed 's|.*/||' \
    | grep -E "^${kube_version}\." \
    | sort -V \
    | tail -1
}

get_current_base_image_version() {
  local dockerfile="$1"
  local slug="$2"
  grep -E "image-environment-base-${slug}:[0-9]+\.[0-9]+\.[0-9]+" "$dockerfile" \
    | sed -E "s/.*image-environment-base-${slug}:([0-9]+\.[0-9]+\.[0-9]+).*/\1/" \
    | head -1
}

update_dockerfile_base_image_version() {
  local dockerfile="$1"
  local slug="$2"
  local old_version="$3"
  local new_version="$4"
  sed -i.bak "s|image-environment-base-${slug}:${old_version}|image-environment-base-${slug}:${new_version}|g" "$dockerfile"
  rm -f "${dockerfile}.bak"
}

upgrade_base_image() {
  local slug="$1"
  local kube_version="$2"
  local current_base_version
  current_base_version=$(get_current_base_image_version "$DOCKERFILE_PATH" "$slug")
  if [[ -z "$current_base_version" ]]; then
    log "No base image FROM line found in $DOCKERFILE_PATH"
    return 0
  fi
  local latest_base_version
  latest_base_version=$(get_latest_base_image_tag "$slug" "$kube_version")
  if [[ -z "$latest_base_version" ]]; then
    log "No matching base image tag found for ${kube_version}.*"
    return 0
  fi
  if [[ "$current_base_version" == "$latest_base_version" ]]; then
    log "Base image already at $latest_base_version"
    return 0
  fi
  log "Upgrading base image $current_base_version -> $latest_base_version"
  update_dockerfile_base_image_version "$DOCKERFILE_PATH" "$slug" "$current_base_version" "$latest_base_version"
  git add "$DOCKERFILE_PATH"
  git commit -m "Upgrade to latest base image: ${latest_base_version}."
}

# Bring the local branch in line with its upstream without losing local work.
# Fast-forward first, which also covers being merely ahead: the upstream is an
# ancestor, so it is a no-op and hand-made commits stay put to ride along in the
# PR. Only genuine divergence, upstream moved AND local commits exist, needs the
# rebase. A rebase that stops for conflicts is aborted and reported: half-rebased
# repos are worse than untouched ones, and only a human can settle the conflict.
# Uses plain git rather than the ff alias so it does not depend on user config.
sync_to_upstream() {
  local branch="$1"
  if git merge --ff-only "origin/${branch}"; then
    return 0
  fi
  warn "${branch} has diverged from origin/${branch} - rebasing local commits onto it"
  if git rebase "origin/${branch}"; then
    log "Rebased local commits on ${branch} onto origin/${branch}"
    return 0
  fi
  git rebase --abort 2>/dev/null || true
  return 1
}

ensure_clean_state() {
  local repo_dir="$1"
  cd "$repo_dir"

  # Stash any modified files BEFORE checkout to avoid losing work
  if ! git diff --quiet || ! git diff --cached --quiet; then
    log "Stashing uncommitted changes"
    git stash save "unfinished work auto stashed"
  fi

  # Checkout main
  git checkout main

  # Fetch and line up with the upstream, keeping any local commits
  git fetch origin
  if ! sync_to_upstream main; then
    return 1
  fi

  # Verify clean state
  if ! git diff --quiet || ! git diff --cached --quiet; then
    return 1
  fi
  return 0
}

process_repo() {
  local repo_name="$1"
  local repo_dir="${IMAGE_BASE_DIR}/${repo_name}"

  if [[ ! -d "$repo_dir" ]]; then
    log "Skipping $repo_name - directory not found"
    return 0
  fi

  log "Processing $repo_name"
  cd "$repo_dir"

  # Ensure clean state on main
  if ! ensure_clean_state "$repo_dir"; then
    record_failure "$repo_name" "Repository not clean after stash and merge"
    return 1
  fi

  local slug="${repo_name#image-environment-deploy-}"
  local target_version="$NEW_VERSION"
  local commit_message="Upgrade to Kaptain Deploy Scripts ${target_version} - see that project for changes included."

  # Process kubectl version branches
  for kube_version in "${KUBECTL_VERSIONS[@]}"; do
    local branch_name
    local push_branch
    local base_branch

    if [[ "$kube_version" == "$MAIN_KUBECTL_VERSION" ]]; then
      branch_name="main"
      push_branch="upgrade-${kube_version}-to-deploy-scripts-${target_version}"
      base_branch="main"

      # Fetch, checkout, sync - same as every other branch
      git fetch origin
      git checkout main
      if ! sync_to_upstream main; then
        record_failure "$repo_name/main" "Diverged from origin/main and the rebase hit conflicts - resolve by hand"
        continue
      fi

      upgrade_base_image "$slug" "$kube_version"

      if ! upgrade_deploy_scripts_version "$repo_name/$branch_name" "$target_version" "$commit_message"; then
        continue
      fi

      upgrade_build_tooling
    else
      branch_name="main-${kube_version}"
      push_branch="upgrade-${kube_version}-to-deploy-scripts-${target_version}"
      base_branch="main-${kube_version}"

      # Fetch to get latest remote state
      git fetch origin

      if git show-ref --verify --quiet "refs/remotes/origin/${branch_name}"; then
        # Remote branch exists
        if git show-ref --verify --quiet "refs/heads/${branch_name}"; then
          # Local branch exists - checkout and sync with the remote
          git checkout "$branch_name"
          if ! sync_to_upstream "$branch_name"; then
            record_failure "$repo_name/$branch_name" "Diverged from origin/${branch_name} and the rebase hit conflicts - resolve by hand"
            git checkout main
            continue
          fi
        else
          # Local branch doesn't exist - create tracking branch from remote
          git checkout -b "$branch_name" "origin/${branch_name}"
        fi

        upgrade_base_image "$slug" "$kube_version"

        if ! upgrade_deploy_scripts_version "$repo_name/$branch_name" "$target_version" "$commit_message"; then
          git checkout main
          continue
        fi

        upgrade_build_tooling
      else
        # Remote branch doesn't exist - create local, apply changes, push directly (no PR)
        log "Remote branch ${branch_name} doesn't exist - creating and pushing directly"
        if git show-ref --verify --quiet "refs/heads/${branch_name}"; then
          git checkout "$branch_name"
        else
          # Find a tag with this kubectl version to branch from
          local source_tag
          source_tag=$(find_tag_for_kubectl_version "$kube_version")
          if [[ -n "$source_tag" ]]; then
            log "Creating ${branch_name} from tag ${source_tag}"
            git checkout -b "$branch_name" "$source_tag"
          else
            record_failure "$repo_name/$branch_name" "No tag found containing ${kube_version}"
            continue
          fi
        fi

        upgrade_base_image "$slug" "$kube_version"

        # Make the change directly on this branch
        if ! upgrade_deploy_scripts_version "$repo_name/$branch_name" "$target_version" "$commit_message"; then
          git checkout main
          continue
        fi

        upgrade_build_tooling

        # Push directly to remote branch (no PR)
        if ! git push origin "${branch_name}:${branch_name}"; then
          record_failure "$repo_name/$branch_name" "Failed to push to remote branch ${branch_name}"
        else
          log "Created remote branch ${branch_name}"
        fi
        git checkout main
        continue
      fi
    fi

    # Check if there's anything to push (any commits ahead of remote base)
    local commits_ahead
    commits_ahead=$(git rev-list --count "origin/${base_branch}..HEAD" 2>/dev/null || echo "0")
    if [[ "$commits_ahead" == "0" ]]; then
      log "No changes to push for $branch_name - skipping PR"
      git checkout main
      continue
    fi

    # Decide whether we have new content to push or the remote upgrade branch
    # already matches local. Lets us pick accurate logs: "Creating PR" only when
    # something actually new is being submitted, otherwise just look up the existing PR.
    local local_sha remote_push_sha
    local_sha=$(git rev-parse HEAD)
    remote_push_sha=$(git ls-remote origin "${push_branch}" 2>/dev/null | awk '{print $1}')

    local pr_url=""
    if [[ -n "${remote_push_sha}" && "${local_sha}" == "${remote_push_sha}" ]]; then
      log "No new changes for ${push_branch} - checking for existing PR"
      pr_url=$(gh pr list --head "$push_branch" --json url --jq '.[0].url' 2>/dev/null || true)
      if [[ -n "$pr_url" ]]; then
        log "Found existing PR: ${pr_url}"
      else
        log "No PR found for ${push_branch}"
      fi
    else
      log "Pushing ${branch_name} -> origin/${push_branch}"
      if ! git push origin "${branch_name}:${push_branch}"; then
        record_failure "$repo_name/$branch_name" "Push failed"
        git checkout main
        continue
      fi

      log "Creating PR for ${push_branch}"
      pr_url=$(gh pr create \
        --title "$commit_message" \
        --body "" \
        --base "$base_branch" \
        --head "$push_branch" \
        2>&1) || {
          # PR might already exist (someone created it manually, or a race with another run)
          if [[ "$pr_url" == *"already exists"* ]]; then
            pr_url=$(gh pr list --head "$push_branch" --json url --jq '.[0].url' 2>/dev/null || true)
            if [[ -n "$pr_url" ]]; then
              log "Found existing PR: ${pr_url}"
            else
              log "PR already exists for ${push_branch} (could not resolve URL)"
            fi
          else
            record_failure "$repo_name/$branch_name" "PR creation failed: $pr_url"
            pr_url=""
          fi
        }
    fi

    # Deliberately no 'gh pr merge --auto' here. On a branch with no required
    # status checks there is nothing for auto-merge to wait for, so GitHub
    # merges the moment it has computed mergeability - which has landed merges
    # seconds after creation, before the build workflow even existed. Merging is
    # wait_for_prs' job, once checks have appeared and passed.
    if [[ -n "$pr_url" && "$pr_url" == http* ]]; then
      CREATED_PRS+=("$pr_url")
    fi

    # Return to main for next iteration
    git checkout main
  done
}

already_tracked() {
  local candidate="$1"
  local tracked
  for tracked in ${CREATED_PRS[@]+"${CREATED_PRS[@]}"}; do
    if [[ "${tracked}" == "${candidate}" ]]; then
      return 0
    fi
  done
  return 1
}

# Scan every deploy repo for open PRs whose head matches this script's naming
# convention for the target version, and track any this run did not create
# itself. Runs unconditionally: a partial run creates some PRs and leaves
# earlier ones open, and those still need monitoring and merging (e.g. a
# previous run created them but auto-merge couldn't fire).
discover_existing_prs() {
  local repo url suffix
  suffix="-to-deploy-scripts-${NEW_VERSION}"
  for repo in "${DEPLOY_IMAGE_DIRS[@]}"; do
    while IFS= read -r url; do
      [[ -z "${url}" ]] && continue
      if already_tracked "${url}"; then
        continue
      fi
      CREATED_PRS+=("${url}")
      log "Discovered existing PR: ${url}"
    done < <(gh pr list \
      --repo "${GITHUB_ORG}/${repo}" \
      --state open \
      --json url,headRefName \
      --jq ".[] | select(.headRefName | endswith(\"${suffix}\")) | .url" \
      2>/dev/null || true)
  done
}

# Poll until all CREATED_PRS reach MERGED. A PR that fails its checks, gets
# closed, or cannot be merged is recorded and dropped from the poll set - the
# others keep going, since one repo's broken build is no reason to abandon the
# rest half merged.
# A PR is merged here only once its checks have appeared AND all passed. An
# empty check list means "not registered yet", never "clean": merging on empty
# is what let a red build land. Checks that never appear simply keep the PR
# pending until POLL_TIMEOUT reports it - unverified is never merged.
# Configurable via POLL_INTERVAL (default 30s) and POLL_TIMEOUT (default 1800s).
wait_for_prs() {
  local poll_interval="${POLL_INTERVAL:-30}"
  local poll_timeout="${POLL_TIMEOUT:-1800}"
  local elapsed=0
  local -a pending=("${CREATED_PRS[@]}")
  local -a still_pending
  local pr state check_states merge_state auto
  local unmerged=0

  log "Waiting for ${#pending[@]} PR(s) to merge (poll=${poll_interval}s, timeout=${poll_timeout}s)..."

  while [[ ${#pending[@]} -gt 0 ]]; do
    if [[ "${elapsed}" -ge "${poll_timeout}" ]]; then
      for pr in "${pending[@]}"; do
        record_failure "${pr}" "Did not merge within ${poll_timeout}s"
      done
      return 1
    fi

    still_pending=()
    for pr in "${pending[@]}"; do
      state=$(gh pr view "${pr}" --json state --jq '.state' 2>/dev/null || echo "UNKNOWN")
      case "${state}" in
        MERGED)
          log "Merged: ${pr}"
          ;;
        CLOSED)
          record_failure "${pr}" "PR closed without merging"
          unmerged=$((unmerged + 1))
          ;;
        OPEN)
          check_states=$(gh pr checks "${pr}" --json state --jq '.[].state' 2>/dev/null || true)

          # No checks registered yet - wait for them rather than merging blind.
          if [[ -z "${check_states}" ]]; then
            still_pending+=("${pr}")
            continue
          fi

          if grep -qE '^(FAILURE|ERROR|CANCELLED|TIMED_OUT|STARTUP_FAILURE|ACTION_REQUIRED)$' <<< "${check_states}"; then
            record_failure "${pr}" "Has failed checks"
            unmerged=$((unmerged + 1))
            continue
          fi

          # Any state that is not a pass is still running, so keep waiting.
          if grep -qvE '^(SUCCESS|NEUTRAL|SKIPPED)$' <<< "${check_states}"; then
            still_pending+=("${pr}")
            continue
          fi

          # Every check we can see has passed, but gh pr checks lists what exists
          # on the head commit, not what the branch rules REQUIRE - a required
          # context that has not been created yet looks like an all-pass. GitHub
          # knows the difference, so take its verdict: only CLEAN is mergeable.
          merge_state=$(gh pr view "${pr}" --json mergeStateStatus --jq '.mergeStateStatus' 2>/dev/null || echo "UNKNOWN")
          case "${merge_state}" in
            CLEAN)
              ;;
            BLOCKED|UNKNOWN)
              # Required contexts still outstanding, or GitHub still computing.
              # Neither resolves by merging, so wait: POLL_TIMEOUT reports it.
              still_pending+=("${pr}")
              continue
              ;;
            *)
              # BEHIND, DIRTY, DRAFT, UNSTABLE and anything new: none are ours to
              # fix here (this script does not rebase), so name the state and move on.
              record_failure "${pr}" "Not merging - merge state ${merge_state}"
              unmerged=$((unmerged + 1))
              continue
              ;;
          esac

          # Auto-merge, if the branch rules enabled it, will land this on its
          # own; otherwise merge it here.
          auto=$(gh pr view "${pr}" --json autoMergeRequest --jq '.autoMergeRequest != null' 2>/dev/null || echo "false")
          if [[ "${auto}" == "true" ]]; then
            still_pending+=("${pr}")
            continue
          fi

          log "All checks passed - merging ${pr}"
          if gh pr merge "${pr}" --merge --delete-branch 2>/dev/null; then
            log "Merged: ${pr}"
          else
            record_failure "${pr}" "Direct merge failed"
            unmerged=$((unmerged + 1))
          fi
          ;;
        *)
          # UNKNOWN or transient — keep polling
          still_pending+=("${pr}")
          ;;
      esac
    done

    # Bash 3.2 safe array reassignment under set -u
    if [[ ${#still_pending[@]} -gt 0 ]]; then
      pending=("${still_pending[@]}")
    else
      pending=()
    fi

    if [[ ${#pending[@]} -gt 0 ]]; then
      sleep "${poll_interval}"
      elapsed=$((elapsed + poll_interval))
    fi
  done

  if [[ "${unmerged}" -gt 0 ]]; then
    log "Polling done - ${unmerged} PR(s) did not merge, see failures below."
    return 1
  fi

  log "All PRs merged."
  return 0
}

main() {
  log "Starting deploy scripts upgrade"

  if [[ ! -d "$IMAGE_BASE_DIR" ]]; then
    echo "ERROR: Image base directory not found: $IMAGE_BASE_DIR" >&2
    exit 1
  fi

  # A MAIN_KUBECTL_VERSION outside the list would silently treat main as a
  # main-1.3X branch and push the newest version nowhere.
  if [[ " ${KUBECTL_VERSIONS[*]} " != *" ${MAIN_KUBECTL_VERSION} "* ]]; then
    echo "ERROR: MAIN_KUBECTL_VERSION ${MAIN_KUBECTL_VERSION} is not in KUBECTL_VERSIONS" >&2
    exit 1
  fi

  # Resolve target versions from remote repos
  LATEST_BUILDON_VERSION=$(get_latest_remote_tag "buildon-github-actions")
  if [[ -z "$LATEST_BUILDON_VERSION" ]]; then
    echo "ERROR: Could not determine latest buildon-github-actions version" >&2
    exit 1
  fi
  log "Latest buildon-github-actions: $LATEST_BUILDON_VERSION"

  LATEST_SCHEMA_VERSION=$(get_schema_version_for_buildon_tag "$LATEST_BUILDON_VERSION")
  if [[ -z "$LATEST_SCHEMA_VERSION" ]]; then
    warn "Could not resolve schema version for $LATEST_BUILDON_VERSION - leaving apiVersion alone"
  else
    log "Schema version shipped by $LATEST_BUILDON_VERSION: $LATEST_SCHEMA_VERSION"
  fi

  if [[ -z "$NEW_VERSION" ]]; then
    NEW_VERSION=$(get_latest_remote_tag "kaptain-deploy-scripts")
    if [[ -z "$NEW_VERSION" ]]; then
      echo "ERROR: Could not determine latest kaptain-deploy-scripts version" >&2
      exit 1
    fi
    log "Latest kaptain-deploy-scripts: $NEW_VERSION"
  else
    log "Using specified deploy-scripts version: $NEW_VERSION"
  fi

  for repo in "${DEPLOY_IMAGE_DIRS[@]}"; do
    process_repo "$repo" || true
  done

  log "Scanning for open upgrade PRs this run did not create..."
  discover_existing_prs

  echo ""
  log "Upgrade complete!"

  if [[ ${#CREATED_PRS[@]} -gt 0 ]]; then
    echo ""
    echo "Created or existing found PRs:"
    for pr in "${CREATED_PRS[@]}"; do
      echo "  $pr"
    done

    echo ""
    wait_for_prs || true
  fi

  if [[ ${#FAILURES[@]} -gt 0 ]]; then
    echo ""
    echo "FAILURES requiring manual attention:"
    for failure in "${FAILURES[@]}"; do
      echo "  - $failure"
    done
    exit 1
  fi
}

main "$@"
